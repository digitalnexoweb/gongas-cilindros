# La conexión con Supabase. Copiá este archivo como .env.local y completalo.
#
# Las dos son públicas por diseño: van en el navegador de cualquiera que abra la
# app. La seguridad no depende de esconderlas sino de las reglas por fila de la
# base. La clave de servicio (service_role) NO va acá ni en ningún lado del
# proyecto.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
